{
  "version": 1,
  "spec": "scripts/spec/QUESTION_QUALITY_SPEC.md",
  "note": "Executable form of the canonical specification. Both the Python and the JavaScript implementation must reproduce every expectation here exactly. CI fails if the two disagree on any case.",

  "parse": [
    { "input": "7",            "expect": { "kind": "number", "num": 7, "den": 1 } },
    { "input": "-8",           "expect": { "kind": "number", "num": -8, "den": 1 } },
    { "input": "1,500",        "expect": { "kind": "number", "num": 1500, "den": 1 } },
    { "input": "12.50",        "expect": { "kind": "number", "num": 25, "den": 2, "written_decimals": 2 } },
    { "input": "12.5",         "expect": { "kind": "number", "num": 25, "den": 2, "written_decimals": 1 } },
    { "input": "2.0",          "expect": { "kind": "number", "num": 2, "den": 1, "written_decimals": 1 } },
    { "input": "3/4",          "expect": { "kind": "number", "num": 3, "den": 4, "written_num": 3, "written_den": 4 } },
    { "input": "3/9",          "expect": { "kind": "number", "num": 1, "den": 3, "written_num": 3, "written_den": 9 } },
    { "input": "1/1",          "expect": { "kind": "number", "num": 1, "den": 1, "written_num": 1, "written_den": 1 } },
    { "input": "7/7",          "expect": { "kind": "number", "num": 1, "den": 1, "written_num": 7, "written_den": 7 } },
    { "input": "3/2",          "expect": { "kind": "number", "num": 3, "den": 2, "written_num": 3, "written_den": 2 } },
    { "input": "1 1/2",        "expect": { "kind": "number", "num": 3, "den": 2, "written_num": 3, "written_den": 2 } },
    { "input": "5/0",          "expect": "PARSE_FAILED", "code": "ZERO_DENOMINATOR" },
    { "input": "50%",          "expect": { "kind": "percent", "num": 50, "den": 1 } },
    { "input": "50 %",         "expect": { "kind": "percent", "num": 50, "den": 1 } },
    { "input": "-40%",         "expect": { "kind": "percent", "num": -40, "den": 1 } },
    { "input": "12.5%",        "expect": { "kind": "percent", "num": 25, "den": 2, "written_decimals": 1 } },
    { "input": "$5",           "expect": { "kind": "currency", "num": 5, "den": 1, "symbol": "$" } },
    { "input": "5 dollars",    "expect": { "kind": "currency", "num": 5, "den": 1, "symbol": "$" } },
    { "input": "$1.50",        "expect": { "kind": "currency", "num": 3, "den": 2, "symbol": "$", "written_decimals": 2 } },
    { "input": "85\u00a2",     "expect": { "kind": "currency", "num": 85, "den": 1, "symbol": "\u00a2" } },
    { "input": "85 cents",     "expect": { "kind": "currency", "num": 85, "den": 1, "symbol": "\u00a2" } },
    { "input": "5 cm",         "expect": { "kind": "measurement", "num": 5, "den": 1, "unit": "cm" } },
    { "input": "70 m\u00b2",   "expect": { "kind": "measurement", "num": 70, "den": 1, "unit": "m2" } },
    { "input": "24 cm3",       "expect": { "kind": "measurement", "num": 24, "den": 1, "unit": "cm3" } },
    { "input": "90\u00b0",     "expect": { "kind": "measurement", "num": 90, "den": 1, "unit": "deg" } },
    { "input": "2:30",         "expect": { "kind": "time", "minutes": 150, "meridiem": null } },
    { "input": "2:03",         "expect": { "kind": "time", "minutes": 123, "meridiem": null } },
    { "input": "5:00 PM",      "expect": { "kind": "time", "minutes": 300, "meridiem": "PM" } },
    { "input": "12:00 AM",     "expect": { "kind": "time", "minutes": 0, "meridiem": "AM" } },
    { "input": "2:3",          "expect": { "kind": "ratio", "terms": [2, 3] } },
    { "input": "4:6",          "expect": { "kind": "ratio", "terms": [2, 3] } },
    { "input": "4 R2",         "expect": { "kind": "quotrem", "q": 4, "r": 2 } },
    { "input": "7 remainder 1","expect": { "kind": "quotrem", "q": 7, "r": 1 } },
    { "input": "hexagon",      "expect": { "kind": "text", "value": "hexagon" } },
    { "input": "The blue ribbon, by 7 cm", "expect": { "kind": "text", "value": "the blue ribbon, by 7 cm" } },
    { "input": "3 tenths",     "expect": { "kind": "text", "value": "3 tenths" } },
    { "input": "3 ones",       "expect": { "kind": "text", "value": "3 ones" } },
    { "input": "x = 4, y = 0", "expect": { "kind": "text", "value": "x = 4, y = 0" } },
    { "input": "9 remainder 2 with 5 left over", "expect": { "kind": "text", "value": "9 remainder 2 with 5 left over" } },
    { "input": "  Hexagon  ",  "expect": { "kind": "text", "value": "hexagon" } },
    { "input": "Both A and B", "expect": { "kind": "text", "value": "both a and b" } },
    { "input": ">",            "expect": { "kind": "text", "value": ">" } },
    { "input": "NaN",          "expect": "PARSE_FAILED", "code": "PLACEHOLDER_TEXT" },
    { "input": "undefined",    "expect": "PARSE_FAILED", "code": "PLACEHOLDER_TEXT" },
    { "input": "",             "expect": "PARSE_FAILED", "code": "MISSING_FIELD" }
  ],

  "equivalence": [
    { "a": "2",     "b": "2.0",   "equal": true },
    { "a": "12.5",  "b": "12.50", "equal": true },
    { "a": "1500",  "b": "1,500", "equal": true },
    { "a": "3/4",   "b": "6/8",   "equal": true },
    { "a": "$5",    "b": "5 dollars", "equal": true },
    { "a": "50%",   "b": "50 %",  "equal": true },
    { "a": "2:3",   "b": "4:6",   "equal": true },
    { "a": "hexagon", "b": "Hexagon", "equal": true },
    { "a": "The blue ribbon, by 7 cm", "b": "The blue ribbon, by 7 cm", "equal": true,
      "why": "prose containing digits and a unit must compare as text, not fail to parse" },
    { "a": "3 tenths", "b": "3 tenths", "equal": true },
    { "a": "3 tenths", "b": "3 hundredths", "equal": false },
    { "a": "3",     "b": "3/4",   "equal": false, "code": "VALUE_CHANGED" },
    { "a": "5",     "b": "5/8",   "equal": false, "code": "VALUE_CHANGED" },
    { "a": "830",   "b": "8:30",  "equal": false, "code": "VALUE_CHANGED" },
    { "a": "2",     "b": "2:3",   "equal": false, "code": "VALUE_CHANGED" },
    { "a": "B",     "b": "Both A and B", "equal": false, "code": "VALUE_CHANGED" },
    { "a": "5",     "b": "5 cm",  "equal": false, "code": "UNIT_ASSERTION" },
    { "a": "50",    "b": "50 cm", "equal": false, "code": "UNIT_ASSERTION" },
    { "a": "70",    "b": "70 cents", "equal": false, "code": "UNIT_ASSERTION" },
    { "a": "5 cm",  "b": "5 m",   "equal": false, "code": "UNIT_MISMATCH" },
    { "a": "100 cm","b": "1 m",   "equal": false, "code": "UNIT_MISMATCH",
      "why": "no implicit unit conversion; a converted answer must state its own unit" },
    { "a": "5:00",  "b": "5:00 PM", "equal": false, "code": "VALUE_CHANGED" },
    { "a": "4",     "b": "4 R2",  "equal": false, "code": "VALUE_CHANGED" },
    { "a": "50%",   "b": "0.5",   "equal": false, "code": "VALUE_CHANGED" }
  ],

